{
  "name": "@agent-remote/agentd",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform host daemon for Agent Remote: drives DSH, Codex and Claude and exposes a mobile-friendly WebSocket API.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:platform": "tsx test/platform-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "cross-spawn": "^7.0.6",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
